@startuml
!theme cerulean-outline
skinparam backgroundColor transparent
skinparam defaultFontSize 13
skinparam packageBorderColor #555555
skinparam nodeBorderColor #555555
skinparam cloudBorderColor #555555

title Deployment Architecture

actor "Browser" as browser
cloud "Internet" as internet

frame "Local Machine" {
    agent "Client" as client
}

frame "DigitalOcean" as droplet {
    node "Caddy" as caddy
    node "Discovery" as discovery

    package "Docker" {
        rectangle "3× Entry\n(:9001-3)" as entries
        rectangle "3× Middle\n(:9101-3)" as middles
        rectangle "3× Exit\n(:9201-3)" as exits
    }
}

browser -down-> client
note left on link : SOCKS5
client -down-> discovery : gRPC
client -down-> entries : TCP / TLS
entries -down-> middles : TCP / TLS
middles -down-> exits : TCP / TLS
exits -down-> internet : TCP
browser .down.> caddy : HTTPS
caddy -down-> discovery : HTTP

note bottom of entries
  Discovery selects entry, middle,
  and exit independently per circuit.
  Any entry can connect to any middle,
  any middle to any exit.
end note
@enduml
